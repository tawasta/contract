<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.form.partner.subscribable.products.in.progress</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='contacts_setting_container']" position="inside">
                <setting
                    id="show_partner_subscribable_products_in_progress_page"
                    help="Show a page listing the subscribable products of the contact's ongoing subscriptions on the contact form"
                >
                    <field name="show_partner_subscribable_products_in_progress_page" />
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
