<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- separate paper format for the member certificate pdf print -->
    <record id="paperformat_member_certificate" model="report.paperformat">
        <field name="name">Member Certificate</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">18</field>
        <field name="margin_right">18</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
</odoo>
