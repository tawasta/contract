<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field
            name="name"
        >res.config.settings.form.contract.terminate.reason.default</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="contract.res_config_settings_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//block[@title='Contract']" position="inside">
                <setting
                    string="Default Termination Reason"
                    help="Suggested as a default when terminating a contract"
                >
                    <field
                        name="contract_terminate_reason_default"
                        options="{'no_create_edit': True, 'no_open': True}"
                    />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
