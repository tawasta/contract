<?xml version="1.0" ?>
<odoo noupdate="1">
        <record id="subscription_invitation_email_template" model="mail.template">
            <field name="name">Subscription: Invitation</field>
            <field
            name="model_id"
            ref="subscription_oca.model_sale_subscription_line"
        />
            <field name="subject">You're Invited to join a subscription</field>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="email_to" />
            <field name="description">Invitation to join a subscription</field>
            <field name="body_html" type="html">
                <table
                border="0"
                cellpadding="0"
                cellspacing="0"
                style="padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;"
            >
                    <tr><td align="center">
                        <table
                            border="0"
                            cellpadding="0"
                            cellspacing="0"
                            width="590"
                            style="padding: 16px; background-color: white; color: #454748; border-collapse:separate;"
                        >
                            <tbody>
                                <!-- HEADER -->
                                <tr>
                                    <td align="center" style="min-width: 590px;">
                                        <span
                                            style="font-size: 20px; font-weight: bold;"
                                        >
                                            You're Invited to join a subscription!
                                        </span>
                                    </td>
                                </tr>
                                <!-- INVITATION DETAILS -->
                                <tr>
                                    <td style="text-align:center;">
                                        <hr
                                            width="100%"
                                            style="background-color:rgb(204,204,204);border:none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin:16px 0px 16px 0px;"
                                        />
                                        <div style="font-size: 14px;">
                                            Hello,<br /><br />
                                            You have been invited to join the subscription for
                                            <strong><t
                                                    t-out="object.product_id.display_name"
                                                /></strong>.
                                            To accept this invitation and activate your subscription, please click the button below:
                                            <br /><br />
                                            <a
                                                t-attf-href="/invitation/{{ object.invite_id.id }}/accept?access_token={{ object.invite_id.access_token }}"
                                                style="padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: none !important; font-weight: 400; background-color: #875A7B; border: 0px solid #875A7B; border-radius:3px"
                                                target="_blank"
                                            >
                                                Accept Invitation
                                            </a>
                                        </div>
                                        <hr
                                            width="100%"
                                            style="background-color:rgb(204,204,204);border:none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin:16px 0px 16px 0px;"
                                        />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td></tr>
                </table>
            </field>
            <field name="lang">{{ object.company_id.partner_id.lang }}</field>
        </record>
</odoo>
