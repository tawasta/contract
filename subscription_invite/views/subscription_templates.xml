<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="subscription_links" inherit_id="portal.side_content">
          <xpath expr="//div[@class='o_my_contact']" position="before">
            <t t-set="user_email" t-value="request.env.user.email"/>
            <t t-set="pending_invites" t-value="request.env['subscription.invitation'].sudo().search([('invite_email', '=', user_email), ('is_used', '=', False)])"/>

            <t t-if="pending_invites">
                <div class="alert alert-info">
                    <strong>You have pending subscription invitations!</strong><br/>
                    <ul class="mt-2">
                        <t t-foreach="pending_invites" t-as="inv">
                            <li class="mb-1">
                                <t t-esc="inv.subscription_id.product_id.name"/> – invited on 
                                <t t-esc="inv.invited_date.strftime('%d.%m.%Y %H:%M')"/>
                                <a t-att-href="'/invitation/%s/accept?access_token=%s' % (inv.id, inv.access_token)" class="btn btn-sm btn-primary ms-2">
                                    Accept
                                </a>
                            </li>
                        </t>
                    </ul>
                </div>
            </t>
        </xpath>

    </template>
    <template
        id="portal_my_subscriptions_invite"
        inherit_id="website_subscription.portal_subscription_page"
    >
        <xpath expr="//div[@class='portal_subscription']" position="inside">
            <div
                class="modal fade"
                id="inviteModal"
                tabindex="-1"
                aria-labelledby="inviteModalLabel"
                aria-hidden="true"
            >
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form id="invite-form" method="post" action="/send/invitation">
                            <div class="modal-header">
                                <h5
                                    class="modal-title"
                                    id="inviteModalLabel"
                                >Send Invitation</h5>
                                <button
                                    type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"
                                />
                            </div>
                            <div class="modal-body">
                                <div
                                    id="resendInfo"
                                    class="alert alert-warning d-none"
                                    role="alert"
                                >
                                    You are about to send a new invitation. Sending this will cancel the previous invitation.
                                </div>
                                <div class="mb-3">
                                    <label
                                        for="inviteEmail"
                                        class="form-label"
                                    >Recipient's Email</label>
                                    <input
                                        type="email"
                                        class="form-control"
                                        id="inviteEmail"
                                        name="invite_email"
                                        required="1"
                                    />
                                    <input
                                        type="hidden"
                                        name="line_id"
                                        id="line_id_modal"
                                    />
                                    <input
                                        type="hidden"
                                        name="invite_id"
                                        id="invite_id_modal"
                                    />
                                </div>
                                <div class="mb-3">
                                    <label
                                        for="confirmInviteEmail"
                                        class="form-label"
                                    >Confirm Recipient's Email</label>
                                    <input
                                        type="email"
                                        class="form-control"
                                        id="confirmInviteEmail"
                                        name="confirm_invite_email"
                                        required="1"
                                    />
                                </div>
                                <p id="emailError" class="alert alert-danger d-none">
                                    Emails do not match; please retype them.
                                </p>
                            </div>
                            <div class="modal-footer">
                                <button
                                    type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal"
                                >Close</button>
                                <button
                                    type="submit"
                                    class="btn btn-primary"
                                >Send Invitation</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
    <template
        id="portal_subscription_line_data_invite"
        inherit_id="website_subscription.portal_subscription_line_data"
    >
        <xpath expr="//td[@id='subscription_line_buttons_data']" position="inside">
            <!-- Näytetään kutsupainike, jos kutsuja ei ole vielä lähetetty -->
            <t t-if="not line.invite_id">

                    <button
                    type="button"
                    class="btn btn-primary btn-sm"
                    t-att-data-line-id="line.id"
                    data-bs-toggle="modal"
                    data-bs-target="#inviteModal"
                >
                        <i class="fa fa-envelope" /> Send Invitation
                    </button>

            </t>

            <!-- Jos kutsu on lähetetty, näytetään sen tila -->
            <t t-if="line.invite_id">

                    <t t-if="line.invite_id.is_used">
                        <!-- Näytetään jos kutsu on käytetty -->
                        <div class="d-flex flex-column align-items-start">
                            <span class="badge bg-success text-wrap">
                                Invitation accepted on
                                <t
                                t-esc="line.invite_id.used_date.strftime('%d.%m.%Y %H:%M:%S')"
                            />
                            </span>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="d-flex flex-column align-items-start">
                            <span class="badge bg-warning mb-2 text-wrap">
                                Invitation sent on
                                <t
                                t-esc="line.invite_id.invited_date.strftime('%d.%m.%Y %H:%M:%S')"
                            />
                                , not yet accepted.
                            </span>

                            <!-- Uudelleenlähetyspainike -->
                            <button
                            type="button"
                            class="btn btn-outline-secondary btn-sm"
                            t-att-data-line-id="line.id"
                            t-att-data-invite-id="line.invite_id.id"
                            data-bs-toggle="modal"
                            data-bs-target="#inviteModal"
                            t-att-data-resend="true"
                        >
                                <i class="fa fa-envelope" /> Resend Invitation
                            </button>
                        </div>
                    </t>

            </t>
        </xpath>
    </template>

    <template id="subscription_invitation_form" name="subscription Invitation Form">
    <t t-call="website.layout">
        <div class="container mt-5">
            <div class="row">
                <div class="col-md-8 offset-md-2">
                    <div class="card">
                        <div class="card-header bg-primary">
                            <h3 class="card-title">You're Invited to the: <strong><t
                                            t-esc="invitation.subscription_id.product_id.name"
                                        /></strong></h3>
                        </div>
                        <div class="card-body">
                            <p class="lead">
                                Dear <t t-esc="invitation.invite_email" />,
                            </p>
                            <p>
                                You have been invited to join the event <strong><t
                                            t-esc="invitation.subscription_id.product_id.name"
                                        /></strong>.

                                <br />
                            </p>

                            <t
                                    t-if="invitation.is_used and not request.params.get('thank_you')"
                                >
                                <div class="alert alert-info" role="alert">
                                    <strong
                                        >This invitation has already been accepted on <span
                                                t-field="invitation.used_date"
                                                t-options="{'format': 'dd.MM.yyyy HH:mm'}"
                                            /></strong>
                                </div>
                            </t>
                            <t t-elif="request.params.get('thank_you')">
                                <div class="alert alert-success" role="alert">
                                    <strong
                                        >Thank you! Your invitation has been successfully accepted.</strong>
                                </div>
                            </t>
                            <t t-else="">
                                <form
                                        method="post"
                                        action="/accept_subscription_invitation"
                                    >
                                    <input
                                            type="hidden"
                                            name="invite_id"
                                            t-att-value="invitation.id"
                                        />
                                    <input
                                            type="hidden"
                                            name="subscription_id"
                                            t-att-value="invitation.subscription_id.id"
                                        />
                                    <input
                                            type="hidden"
                                            name="access_token"
                                            t-att-value="invitation.access_token"
                                        />
                                    <input
                                            type="hidden"
                                            name="return_url"
                                            t-att-value="request.httprequest.path"
                                        />
                                    <input
                                            type="hidden"
                                            name="csrf_token"
                                            t-att-value="request.csrf_token()"
                                        />
                                    <div class="form-group mt-3">
                                        <button
                                                type="submit"
                                                class="btn btn-success"
                                            >Accept Invitation</button>
                                    </div>

                                </form>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</template>


</odoo>
