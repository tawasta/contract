<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_partner_form_overdue_subscription" model="ir.ui.view">
        <field name="name">res.partner.form.overdue.subscription</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="industry_id" position="after">
                <field name="has_overdue_subscription_invoices" readonly="1" />
            </field>
        </field>
    </record>

    <record id="view_partner_tree_overdue_subscription" model="ir.ui.view">
        <field name="name">res.partner.tree.overdue.subscription</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field
                    name="has_overdue_subscription_invoices"
                    optional="hide"
                    readonly="1"
                />
            </field>
        </field>
    </record>

    <record id="view_res_partner_filter_overdue_subscription" model="ir.ui.view">
        <field name="name">res.partner.search.overdue.subscription</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <filter name="type_company" position="after">
                <separator />
                <filter
                    name="overdue_subscription_invoices"
                    string="Overdue Subscription Invoices"
                    domain="[('has_overdue_subscription_invoices', '=', True)]"
                />
            </filter>
        </field>
    </record>

</odoo>
