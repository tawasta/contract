<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
        <record id="ir_cron_update_overdue_subscription_invoices" model="ir.cron">
            <field
            name="name"
        >Contacts: Compute 'Has Overdue Subscription Invoices?' Field</field>
            <field name="model_id" ref="base.model_res_partner" />
            <field name="user_id" ref="base.user_root" />
            <field name="state">code</field>
            <field
            name="code"
        >model._cron_update_overdue_subscription_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False" />
            <field name="active" eval="True" />
            <field
            name="nextcall"
            eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:00:00')"
        />
        </record>
</odoo>
