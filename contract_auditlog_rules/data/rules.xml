<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
  <record model="auditlog.rule" id="auditlog-rule-contract">
    <field name="name">Contract</field>
    <field name="model_id" ref="contract.model_contract_contract" />
    <field name="log_type">fast</field>
  </record>

  <record model="auditlog.rule" id="auditlog-rule-contract-line">
    <field name="name">Contract line</field>
    <field name="model_id" ref="contract.model_contract_line" />
    <field name="log_type">fast</field>
  </record>

  <!-- Creates the "View logs" shortcut action, which plain create does not do -->
  <function
    model="auditlog.rule"
    name="set_to_confirmed"
    eval="[[ref('auditlog-rule-contract'),
    ref('auditlog-rule-contract-line')]]"
  />
</odoo>
