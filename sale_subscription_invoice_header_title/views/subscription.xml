<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_subscription_form" model="ir.ui.view">
        <field name="name">sale.subscription.form.period.markers</field>
        <field name="model">sale.subscription</field>
        <field name="inherit_id" ref="subscription_oca.sale_subscription_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="header_text" />
            </field>
        </field>
    </record>

    <record id="sale_subscription_tree" model="ir.ui.view">
        <field name="name">sale.subscription.tree.inherit.header</field>
        <field name="model">sale.subscription</field>
        <field name="inherit_id" ref="subscription_oca.sale_subscription_tree" />
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='partner_id']" position="after">
                <field name="code" optional="header_text"/>
            </xpath>
        </field>
    </record>
</odoo>
