<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_subscription_form" model="ir.ui.view">
        <field name="name">sale.subscription.form.analytic</field>
        <field name="model">sale.subscription</field>
        <field name="inherit_id" ref="subscription_oca.sale_subscription_form" />
        <field name="arch" type="xml">
            <field name="discount" position="after">
                <field
                    name="analytic_distribution"
                    widget="analytic_distribution"
                    optional="hide"
                    groups="analytic.group_analytic_accounting"
                    options="{'product_field': 'product_id', 'business_domain': 'sale_subscription', 'amount_field': 'price_subtotal'}"
                />
            </field>

        </field>
    </record>
</odoo>
