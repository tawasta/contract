<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="portal_edit_customer_button"
        inherit_id="website_subscription.portal_subscription_page"
        name="Add Edit Button to Customer Details"
    >
        <xpath expr="//div[@id='customer_information']//h6" position="inside">
            <button
                type="button"
                id="modal_customer_edit"
                t-if="subscription.partner_id == request.env.user.partner_id"
                class="btn btn-primary btn-sm"
                t-att-partner-id="subscription.partner_id.id"
            >
                    <i class="fa fa-fw fa-pencil" />Edit
                </button>
        </xpath>
    </template>

    <template id="portal_edit_customer_modal" name="Edit Customer Modal">
        <div id="modal_customer_edit" class="modal fade" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content shadow-lg border-0 overflow-hidden">
                    <div class="modal-header bg-primary text-white py-3">
                        <h5
                            class="modal-title font-weight-bold"
                        >Edit Customer Information</h5>
                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                        />
                    </div>

                        <form
                        id="edit_customer_form"
                        t-attf-action="/update_customer/#{user_partner_id.id}"
                        method="post"
                    >
                            <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />
                            <div class="modal-body bg-light">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group p-1">
                                            <label
                                            for="customer_firstname"
                                            class="font-weight-bold text-dark"
                                        >First Name</label>
                                            <input
                                            type="text"
                                            class="form-control border rounded-lg shadow-sm"
                                            id="customer_firstname"
                                            name="firstname"
                                            t-att-value="user_partner_id.firstname"
                                            required="1"
                                        />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group p-1">
                                            <label
                                            for="customer_lastname"
                                            class="font-weight-bold text-dark"
                                        >Last Name</label>
                                            <input
                                            type="text"
                                            class="form-control border rounded-lg shadow-sm"
                                            id="customer_lastname"
                                            name="lastname"
                                            t-att-value="user_partner_id.lastname"
                                            required="1"
                                        />
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group p-1">
                                            <label
                                            for="customer_email"
                                            class="font-weight-bold text-dark"
                                        >Email</label>
                                            <input
                                            type="email"
                                            class="form-control border rounded-lg shadow-sm"
                                            id="customer_email"
                                            name="email"
                                            t-att-value="user_partner_id.email"
                                            required="1"
                                        />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group p-1">
                                            <label
                                            for="customer_phone"
                                            class="font-weight-bold text-dark"
                                        >Phone</label>
                                            <input
                                            type="text"
                                            class="form-control border rounded-lg shadow-sm"
                                            id="customer_phone"
                                            name="phone"
                                            t-att-value="user_partner_id.phone"
                                        />
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group p-1">
                                    <label
                                    for="customer_street"
                                    class="font-weight-bold text-dark"
                                >Street</label>
                                    <input
                                    type="text"
                                    class="form-control border rounded-lg shadow-sm"
                                    id="customer_street"
                                    name="street"
                                    t-att-value="user_partner_id.street"
                                />
                                </div>
                            </div>
                            <div class="text-right mt-3 modal-footer">
                                <button
                                type="submit"
                                class="btn btn-success px-4 py-2 rounded-lg shadow"
                            >Save Changes</button>
                                <button
                                type="button"
                                class="btn btn-secondary px-4 py-2 rounded-lg shadow"
                                data-bs-dismiss="modal"
                            >Cancel</button>
                            </div>
                        </form>

                </div>
            </div>
        </div>
    </template>
</odoo>
