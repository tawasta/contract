<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="portal_edit_customer_button"
        inherit_id="website_subscription.portal_subscription_page"
        name="Add Edit Button to Customer Details"
    >
        <xpath expr="//div[@id='customer_information']//h6" position="inside">
            <button
                type="button"
                id="modal_customer_edit"
                class="btn btn-primary btn-sm"
                t-att-partner-id="subscription.partner_id.id"
                t-att-subscription-id="subscription.id"
            >
                    <i class="fa fa-fw fa-pencil" />Edit
                </button>
        </xpath>
    </template>

    <template id="portal_edit_customer_modal" name="Edit Customer Modal">
        <div
            id="subscription_invoice_address_modal"
            class="modal fade"
            tabindex="-1"
            role="dialog"
            aria-labelledby="subscription_invoice_address_modal_title"
        >
            <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
                <div class="modal-content shadow-lg border-0">
                    <div class="modal-header bg-primary text-white py-3">
                        <h5
                            id="subscription_invoice_address_modal_title"
                            class="modal-title fw-bold text-white"
                        >Edit Customer Information</h5>
                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                        />
                    </div>
                    <form
                        id="edit_customer_form"
                        class="d-flex flex-column overflow-hidden"
                        t-attf-action="/update_customer/#{subscription.partner_id.id}/subscription/#{subscription.id}"
                        method="post"
                        t-att-data-subscription-id="subscription.id"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />
                        <div class="modal-body bg-light">
                            <h6>Select an existing contact or add a new one</h6>
                            <div
                                class="row row-cols-md-2 row-cols-lg-3 g-3 flex-nowrap flex-md-wrap mb32"
                            >
                                <div
                                    t-foreach="contacts"
                                    t-as="contact"
                                    class="one_kanban col-md"
                                >
                                    <t
                                        t-set="is_current"
                                        t-value="contact == current_contact"
                                    />
                                    <div
                                        t-attf-class="contact-card border rounded-3 p-3 shadow-sm h-100 d-flex flex-column #{'border-success' if is_current else ''}"
                                        t-att-data-contact-id="contact.id"
                                    >
                                        <div
                                            class="d-flex justify-content-between align-items-start gap-2"
                                        >
                                            <strong t-esc="contact.name" />
                                            <span
                                                t-if="is_current"
                                                class="badge text-bg-success"
                                            >
                                                <i
                                                    class="fa fa-check me-1"
                                                    aria-hidden="true"
                                                />In use
                                            </span>
                                        </div>
                                        <p
                                            t-esc="contact.email"
                                            class="text-muted small mb-1"
                                        />
                                        <p
                                            t-esc="contact.street"
                                            t-attf-class="text-muted small #{'mb-1' if show_full_address else ''}"
                                        />
                                        <p
                                            t-if="show_full_address"
                                            class="text-muted small"
                                        >
                                            <t t-esc="contact.zip" /> <t
                                                t-esc="contact.city"
                                            />
                                        </p>
                                        <div
                                            t-if="contact in editable_contacts"
                                            class="mt-auto pt-2"
                                        >
                                            <button
                                                type="button"
                                                class="btn btn-light btn-sm border o_edit_invoice_address"
                                                t-att-data-contact-id="contact.id"
                                            >
                                                <i
                                                    class="fa fa-pencil me-1"
                                                    aria-hidden="true"
                                                />Edit address
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="one_kanban col-md">
                                    <a
                                        role="button"
                                        href="#"
                                        class="o_wsale_add_address d-flex align-items-center justify-content-center h-100 px-4 border rounded mx-auto no-decoration"
                                    >
                                        <i class="fa fa-plus me-md-2" /><span
                                            class="d-none d-md-inline"
                                        >Add new contact</span>
                                    </a>
                                </div>
                            </div>
                            <input
                                type="hidden"
                                name="existing_contact"
                                id="selected_contact"
                            />
                            <div id="new_contact_form" class="collapse mt-3">
                                <t
                                    t-call="website_subscription_partner_edit.portal_invoice_address_form"
                                />
                            </div>
                        </div>
                        <div class="text-end mt-3 modal-footer">
                            <button
                                type="submit"
                                class="btn btn-success px-4 py-2 rounded-3 shadow"
                            >Save Changes</button>
                            <button
                                type="button"
                                class="btn btn-secondary px-4 py-2 rounded-3 shadow"
                                data-bs-dismiss="modal"
                            >Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </template>

    <!-- The fields of a new or an edited invoice address. An empty
         form_contact gives the form of a new address. -->
    <template id="portal_invoice_address_form" name="Invoice Address Form">
        <t t-set="is_company" t-value="form_contact.is_company" />
        <t
            t-set="method_code"
            t-value="form_contact.customer_invoice_transmit_method_id.code"
        />
        <t t-if="form_contact">
            <input type="hidden" name="edit_contact_id" t-att-value="form_contact.id" />
            <h6 class="mb-1">Edit invoice address</h6>
            <p class="form-text mt-0">
                Saving the changes also sets this address as the invoice address of the subscription.
            </p>
        </t>
        <t t-else="">
            <h6>Add New Contact</h6>
            <div class="col-lg-6 mb-2 d-flex align-items-center gap-3">
                <label for="is_company_toggle" class="mb-0">Person</label>
                <div class="form-check form-switch mb-0">
                    <input
                        class="form-check-input"
                        type="checkbox"
                        id="is_company_toggle"
                        name="is_company"
                    />
                </div>
                <label class="mb-0" for="is_company_toggle">Company</label>
            </div>
        </t>

        <div class="row">
            <div
                id="person_name_fields"
                t-attf-class="row #{'d-none' if is_company else ''}"
            >
                <div class="col-lg-6 mb-2">
                    <label
                        class="col-form-label"
                        for="invoice_address_firstname"
                    >First Name</label>
                    <input
                        type="text"
                        id="invoice_address_firstname"
                        name="firstname"
                        t-attf-class="form-control #{'bg-light' if 'firstname' in locked_fields else ''}"
                        t-att-value="form_contact.firstname"
                        t-att-required="None if is_company else '1'"
                        t-att-readonly="'1' if 'firstname' in locked_fields else None"
                    />
                </div>
                <div class="col-lg-6 mb-2">
                    <label
                        class="col-form-label"
                        for="invoice_address_lastname"
                    >Last Name</label>
                    <input
                        type="text"
                        id="invoice_address_lastname"
                        name="lastname"
                        t-attf-class="form-control #{'bg-light' if 'lastname' in locked_fields else ''}"
                        t-att-value="form_contact.lastname"
                        t-att-required="None if is_company else '1'"
                        t-att-readonly="'1' if 'lastname' in locked_fields else None"
                    />
                </div>
            </div>

            <div
                id="company_name_field"
                t-attf-class="col-lg-12 mb-2 #{'' if is_company else 'd-none'}"
            >
                <label
                    class="col-form-label"
                    for="invoice_address_name"
                >Company Name</label>
                <input
                    type="text"
                    id="invoice_address_name"
                    name="name"
                    t-attf-class="form-control #{'bg-light' if 'name' in locked_fields else ''}"
                    t-att-value="form_contact.name if is_company else None"
                    t-att-required="'1' if is_company else None"
                    t-att-readonly="'1' if 'name' in locked_fields else None"
                />
            </div>
            <div
                t-if="'name' in locked_fields"
                class="col-12 form-text mt-0 mb-2"
                t-esc="locked_fields['name']"
            />

            <div id="div_email" class="col-lg-6 mb-2">
                <label for="invoice_address_email" class="col-form-label">Email</label>
                <input
                    type="email"
                    id="invoice_address_email"
                    name="email"
                    t-attf-class="form-control #{'bg-light' if 'email' in locked_fields else ''}"
                    t-att-value="form_contact.email"
                    t-att-readonly="'1' if 'email' in locked_fields else None"
                />
                <div
                    t-if="'email' in locked_fields"
                    class="form-text"
                    t-esc="locked_fields['email']"
                />
            </div>
            <div id="div_phone" class="col-lg-6 mb-2">
                <label class="col-form-label" for="invoice_address_phone">Phone</label>
                <input
                    type="tel"
                    id="invoice_address_phone"
                    name="phone"
                    class="form-control"
                    placeholder="+358"
                    t-att-value="form_contact.phone"
                />
            </div>
            <div
                id="company_registry_group"
                t-attf-class="div_company_registry_billing col-lg-6 mb-2 #{'' if is_company else 'd-none'}"
            >
                <label
                    class="col-form-label fw-normal label-optional"
                    for="invoice_address_company_registry"
                >Business ID</label>
                <input
                    type="text"
                    id="invoice_address_company_registry"
                    name="company_registry"
                    class="form-control"
                    placeholder="1234567-1"
                    t-att-value="form_contact.company_registry"
                />
            </div>
            <div
                id="customer_invoice_transmit_method_id_div"
                class="col-lg-6 mb-2"
                t-if="transmit_methods"
            >
                <label
                    class="col-form-label"
                    for="customer-invoice-transmit-method"
                >Invoice transmit method</label>
                <select
                    id="customer-invoice-transmit-method"
                    class="form-select"
                    name="customer_invoice_transmit_method_id"
                    data-init="1"
                >
                    <!-- An address without a method keeps it empty when saved -->
                    <option
                        t-if="form_contact and not form_contact.customer_invoice_transmit_method_id"
                        value=""
                    >Select a transmit method...</option>
                    <t t-foreach="transmit_methods" t-as="method">
                        <option
                            t-att-value="method.id"
                            t-att-data-code="method.code"
                            t-att-data-type="method.contract_target_type"
                            t-att-selected="method == form_contact.customer_invoice_transmit_method_id or None"
                            t-esc="method.name"
                        />
                    </t>
                </select>
            </div>
            <t
                t-set="show_einvoice"
                t-value="is_company and method_code == 'einvoice'"
            />
            <div
                id="edicode-div"
                t-attf-class="col-md-6 mb-2 div_edicode show-company #{'' if show_einvoice else 'd-none'}"
            >
                <label
                    id="edicode-label"
                    class="col-form-label label-optional"
                    for="invoice_address_edicode"
                >eInvoice Address (EDI-code)</label>
                <input
                    type="text"
                    id="invoice_address_edicode"
                    name="edicode"
                    placeholder="e.g. 003712345671"
                    class="form-control"
                    t-att-value="form_contact.edicode"
                />
            </div>
            <div
                id="einvoice-operator-div"
                t-attf-class="col-lg-6 mb-2 div_einvoice_operator show-company #{'' if show_einvoice else 'd-none'}"
            >
                <label
                    id="einvoice-operator-label"
                    class="col-form-label label-optional"
                    for="einvoice-operator-select"
                >eInvoice Operator</label>
                <select
                    id="einvoice-operator-select"
                    class="form-select"
                    name="einvoice_operator_id"
                >
                    <option value="">Select an operator...</option>
                    <t t-foreach="operators" t-as="op">
                        <option
                            t-att-value="op.id"
                            t-att-selected="op == form_contact.einvoice_operator_id or None"
                        >
                            <t t-esc="op.name" /> (<t t-esc="op.identifier" />)
                        </option>
                    </t>
                </select>
            </div>

            <div class="div_street col-lg-12 mb-2">
                <label
                    class="col-form-label"
                    for="invoice_address_street"
                >Street</label>
                <input
                    type="text"
                    id="invoice_address_street"
                    name="street"
                    class="form-control"
                    required="1"
                    t-att-value="form_contact.street"
                />
            </div>
            <div class="div_zip col-md-4 mb-2">
                <label class="col-form-label" for="invoice_address_zip">Zip</label>
                <input
                    type="text"
                    id="invoice_address_zip"
                    name="zip"
                    class="form-control"
                    required="1"
                    t-att-value="form_contact.zip"
                />
            </div>
            <div class="div_city col-md-8 mb-2">
                <label class="col-form-label" for="invoice_address_city">City</label>
                <input
                    type="text"
                    id="invoice_address_city"
                    name="city"
                    class="form-control"
                    required="1"
                    t-att-value="form_contact.city"
                />
            </div>
            <div class="div_country col-lg-6 mb-2">
                <label class="col-form-label" for="country_id">Country</label>
                <select id="country_id" name="country_id" class="form-select">
                    <option value="">Country...</option>
                    <t t-foreach="countries" t-as="c">
                        <option
                            t-att-value="c.id"
                            t-att-selected="(c == form_contact.country_id if form_contact else c.code == 'FI') or None"
                        >
                            <t t-esc="c.name" />
                        </option>
                    </t>
                </select>
            </div>
        </div>
    </template>
</odoo>
