<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.subscription.partner.edit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <block
                    title="Subscriptions"
                    id="website_subscription_invoice_address_settings"
                    invisible="not website_id"
                >
                    <setting
                        id="subscription_show_current_invoice_address_setting"
                        help="Mark the invoice address currently used by the subscription in the portal address selection."
                    >
                        <field name="subscription_show_current_invoice_address" />
                    </setting>
                    <setting
                        id="subscription_edit_invoice_address_setting"
                        help="Let portal users edit their existing invoice addresses, with the same restrictions as in the checkout."
                    >
                        <field name="subscription_edit_invoice_address" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
