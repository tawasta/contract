<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="product_template_form_view_inherit_membership_check" model="ir.ui.view">
        <field name="name">product.template.form.inherit.membership.check</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="subscription_oca.product_template_form_view" />
        <field name="arch" type="xml">

            <field name="subscription_template_id" position="after">
                <field
                    name="subscription_api_check_count_as_active"
                    invisible="not subscribable"
                />
            </field>
        </field>
    </record>

</odoo>
